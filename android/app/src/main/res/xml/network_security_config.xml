<?xml version="1.0" encoding="utf-8"?>
<!-- The family sites use https certificates from the ADGoose Home CA, so
     trust it as well as the normal ones. -->
<network-security-config>
    <base-config>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/adgoose_home_ca" />
        </trust-anchors>
    </base-config>
</network-security-config>
